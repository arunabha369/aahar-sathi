# The API (server/) runs inside this Next.js app via pages/api, so it reads its settings here.
# Supabase: Connect → "Session pooler" string with your password filled in. On Vercel use the
# same string with port 6543 (the transaction pooler), which suits serverless functions.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# At least 16 characters — generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Enables "Try the demo" (the seeded demo@aaharsathi.in account)
DEMO_ENABLED=true

# Canonical site URL, used for metadataBase, robots.txt and sitemap.xml
NEXT_PUBLIC_SITE_URL=https://aaharsathi.in
