# The API (server/) runs inside this Next.js app via pages/api, so it reads its settings here.
# Supabase: Connect → "Session pooler" string with your password filled in. On Vercel use the
# same string with port 6543 (the transaction pooler), which suits serverless functions.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# At least 16 characters — generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Enables "Try the demo" (the seeded demo@aaharsathi.in account)
DEMO_ENABLED=true

# Canonical site URL, used for metadataBase, robots.txt and sitemap.xml
NEXT_PUBLIC_SITE_URL=https://aaharsathi.in

# Where the site runs: used for password-reset links and the Google sign-in callback.
# On Vercel: https://aaharsathi.in (falls back to NEXT_PUBLIC_SITE_URL when unset).
APP_URL=http://localhost:3000

# Password reset emails via https://resend.com — create an API key and verify your domain.
# Without a key, development prints the reset link to the server log instead.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Aahar Sathi <no-reply@aaharsathi.in>

# "Continue with Google" appears only when both are set. Google Cloud Console → APIs & Services
# → Credentials → OAuth client ID (Web application), with this authorised redirect URI:
#   <APP_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
