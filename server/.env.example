# Server
NODE_ENV=development
PORT=5001

# Database — Postgres. Supabase: open your project → Connect → "Session pooler" and paste
# that string here with your database password filled in. It works over IPv4 everywhere;
# the "Direct connection" host is IPv6-only unless you buy Supabase's IPv4 add-on.
# For local development a plain local Postgres works too: postgresql://localhost:5432/aahar_sathi_dev
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Optional: verify Supabase's TLS certificate. Download it from Supabase → Project Settings →
# Database → SSL configuration, then give its file path or its PEM text (\n for new lines).
# Without it the connection is still encrypted, just not certificate-verified.
# DATABASE_CA_CERT=./prod-supabase.cer

# Optional: connections held open by this server (default 10)
# DATABASE_POOL_SIZE=10

# Auth — use a long random string in production (openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Allowed browser origin. In production the Next.js /api rewrite means the
# browser never calls this server directly, so CORS is only a dev convenience.
CLIENT_ORIGIN=http://localhost:3000

# Enables POST /api/auth/demo (the seeded demo@aaharsathi.in account)
DEMO_ENABLED=true
