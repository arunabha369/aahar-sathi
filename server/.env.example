# Server
NODE_ENV=development
PORT=5001

# Database — Postgres. Supabase: open your project → Connect → "Session pooler" and paste
# that string here with your database password filled in. It works over IPv4 everywhere;
# the "Direct connection" host is IPv6-only unless you buy Supabase's IPv4 add-on.
# For local development a plain local Postgres works too: postgresql://localhost:5432/aahar_sathi_dev
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Optional: verify Supabase's TLS certificate. Download it from Supabase → Project Settings →
# Database → SSL configuration, then give its file path or its PEM text (\n for new lines).
# Without it the connection is still encrypted, just not certificate-verified.
# DATABASE_CA_CERT=./prod-supabase.cer

# Optional: connections held open by this server (default 10)
# DATABASE_POOL_SIZE=10

# Auth — use a long random string in production (openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Allowed browser origin. In production the Next.js /api rewrite means the
# browser never calls this server directly, so CORS is only a dev convenience.
CLIENT_ORIGIN=http://localhost:3000

# Enables POST /api/auth/demo (the seeded demo@aaharsathi.in account)
DEMO_ENABLED=true

# Where the site runs: used for password-reset links and the Google sign-in callback.
# On Vercel: https://aaharsathi.in (falls back to NEXT_PUBLIC_SITE_URL when unset).
APP_URL=http://localhost:3000

# Password reset emails via https://resend.com — create an API key and verify your domain.
# Without a key, development prints the reset link to the server log instead.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Aahar Sathi <no-reply@aaharsathi.in>

# "Continue with Google" appears only when both are set. Google Cloud Console → APIs & Services
# → Credentials → OAuth client ID (Web application), with this authorised redirect URI:
#   <APP_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...

# Reminders (web push). Reminders are offered only when both keys are set. Generate a pair with:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=B...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:support@aaharsathi.in
# The scheduler sends this as "Authorization: Bearer <secret>" to /api/reminders/run
# (openssl rand -base64 32). Then run `npm run reminders:schedule -w server` once.
# CRON_SECRET=...
